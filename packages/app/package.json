{
  "name": "@shoots/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The local web app the Lightroom plug-in opens: a Preact client built into one inline HTML page served by the hidden `shoots app` command.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./page": {
      "types": "./src/page.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shoots/ui": "^0.1.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "preact-render-to-string": "^6.8.1"
  },
  "files": [
    "dist",
    "src"
  ]
}
